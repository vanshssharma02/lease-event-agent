# OpenRouter API credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model configuration
# Note: Slug should be verified on OpenRouter (https://openrouter.ai/models)
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Operating mode: "live" (calls OpenRouter) or "mock" (offline deterministic generator)
LLM_MODE=mock

# Scheduler settings
SCHEDULER_TZ=UTC
SCHEDULER_HOUR=6

# Optional SMTP settings for live email dispatch (if unset, logs locally to DB and data/notifications.log)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=lease-alerts@example.com

# Backend API endpoint for Streamlit UI
API_URL=http://localhost:8000
